# Copy to .env in THIS folder (the project root) and fill in values:
#   PowerShell:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# Only <project root>/.env is read. This template is never loaded, so a key typed here does nothing.
# A variable already set in the terminal that launches the app takes precedence over .env.
# Check what the app sees (never prints the key):  python scripts/check_config.py --verify

# --- Gemini vision (required only for Live mode) ---
# Free key: https://aistudio.google.com/apikey   (GOOGLE_API_KEY is accepted as a fallback name)
GEMINI_API_KEY=

# Model id; confirm availability for your key with: python scripts/check_config.py --verify
GEMINI_MODEL=gemini-2.5-flash
# API version for the Gemini Developer API. Must be v1beta (or v1alpha): the analysis uses a
# system instruction, which "v1" rejects.
GEMINI_API_VERSION=v1beta
# Per-request timeout (seconds), retry attempts for transient errors, min seconds between calls
GEMINI_TIMEOUT_S=90
GEMINI_MAX_RETRIES=4
GEMINI_MIN_INTERVAL=4.5

# --- Retrieval (local, CPU) ---
# Downloaded from Hugging Face on first use (~90 MB), then reused from the local HF cache.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3

# --- Pricing scope ---
PRICING_REGION=IN-DEMO-METRO
PRICING_CURRENCY=INR
# Optional GST as a fraction (0.18 = 18%). Leave empty for tax-exclusive totals.
GST_RATE=

# --- Paths (optional; relative paths resolve from the project root, not the current folder) ---
# KB_DIR=knowledge
# CACHE_DIR=.cache
# KB_INDEX_DIR=.cache/kb-index
# VISION_CACHE_DIR=.cache/vision
# OUTPUT_DIR=outputs
